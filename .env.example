# Copy to .env (gitignored) and fill in.

# --- Analyzer ---
# cached = read fixtures from data/walkthroughs (default local)
# bob    = live Bob Shell analysis (production)
ANALYZER=cached
BOB_API_KEY=
# Spend caps (bob mode). BOB_BUDGET_USD is the total across all runs.
# BOB_BUDGET_USD=28
# MAX_COST=8

# --- Supabase (see docs/deploy.md). Unset = files under data/ as before. ---
# Postgres: walkthroughs, jobs, spend ledger. Transaction pooler URL (port 6543).
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-….pooler.supabase.com:6543/postgres
# Storage: screenshots, narration, replays (public bucket, created automatically).
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BUCKET=walkthrough-assets

# --- Guards for new (paid) analyses ---
# ACCESS_CODE=            # admin key for `force` re-runs and rehearsals only; ordinary analyses need no code
# ANALYZE_DAILY_LIMIT=5   # paid runs per rolling 24 h, 0 = unlimited
# MAX_PR_FILES=80
# MAX_PR_DIFF=2000
# CORS_ORIGINS=           # only needed if the viewer is served from another origin
# GITHUB_TOKEN=   # read token — public PR meta + better rate limits
# GIT_CACHE_DIR=/tmp/pr-walkthrough-repos
# PORT=3000

# ElevenLabs — narration audio (backend only, never sent to the browser).
# Key: Restrict Key on; Text to Speech = Access; Voices = Read; everything else No Access.
ELEVENLABS_API_KEY=
# Optional: voice id (defaults to a stock English voice)
ELEVENLABS_VOICE_ID=
# Generate missing narration on demand when someone presses Listen (spends credits).
# Off by default: without it the viewer uses Web Speech. `tts:pregen` ignores this.
TTS_GENERATE=0

# GitHub round-trip (ST6d) — posts line comments / questions from the viewer
# onto the demo PR at https://github.com/an2323/excalidraw/pull/1 (a fork,
# never upstream). Fine-grained PAT, "Only select repositories" -> an2323/excalidraw:
#   Repository permissions -> Pull requests: Read and write
#   Repository permissions -> Issues: Read and write   (general PR comments use the Issues API)
#   Metadata: Read-only is added automatically.
# Short expiration (e.g. 7 days) is enough for the hackathon. Backend-only —
# never sent to the browser. Without it the UI falls back to copy-to-clipboard.
GITHUB_TOKEN_WRITE=
GITHUB_DEMO_REPO=an2323/excalidraw
GITHUB_DEMO_PR=1
# Optional: which analysed PR the demo PR mirrors (default below). Other PRs can't post.
GITHUB_DEMO_SOURCE=excalidraw/excalidraw#10295

# Before/after screenshots (ST6e): after a live analysis of a repo with an app recipe
# (src/verify/recipes.ts — Excalidraw only), Bob starts nothing itself: the backend runs
# the app at BASE and HEAD, Bob writes/runs a Playwright script. 0 turns it off.
# Ablation (which changes fix the bug, 2 builds per change): 0 = off. Off on the VM.
# VERIFY_ABLATION=0
VERIFY_SHOTS=1
# Bobcoin cap for one verifier run.
VERIFY_MAX_COST=2
