# Copy to .env (gitignored) and fill in.
# Bob Shell API key — type "Inference", created at bob.ibm.com → API keys
BOB_API_KEY=

# ElevenLabs — narration audio (backend only, never sent to the browser).
# Key: Restrict Key on; Text to Speech = Access; Voices = Read; everything else No Access.
ELEVENLABS_API_KEY=
# Optional: voice id (defaults to a stock English voice)
ELEVENLABS_VOICE_ID=

# GitHub round-trip (ST6d) — posts line comments / questions from the viewer
# onto the demo PR at https://github.com/an2323/excalidraw/pull/1 (a fork,
# never upstream). Fine-grained PAT, "Only select repositories" -> an2323/excalidraw:
#   Repository permissions -> Pull requests: Read and write
#   Repository permissions -> Issues: Read and write   (general PR comments use the Issues API)
#   Metadata: Read-only is added automatically.
# Short expiration (e.g. 7 days) is enough for the hackathon. Backend-only —
# never sent to the browser. Without it the UI falls back to copy-to-clipboard.
GITHUB_TOKEN_WRITE=
GITHUB_DEMO_REPO=an2323/excalidraw
GITHUB_DEMO_PR=1
